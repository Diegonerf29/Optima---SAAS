# Caddy en produccion: HTTPS automatico (Let's Encrypt), la web y la API en el mismo dominio
# DOMAIN llega del .env (docker-compose.prod.yml). Con DOMAIN=localhost se puede probar en local.

{$DOMAIN} {
	encode zstd gzip

	# la API y su comprobacion de salud van al contenedor de Spring Boot
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /actuator/health {
		reverse_proxy api:8080
	}

	# todo lo demas es la aplicacion React
	handle {
		root * /srv
		# los ficheros de /assets llevan un hash en el nombre: nunca cambian, cache de un año
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# el resto (index.html) se pide siempre de nuevo para recibir la version nueva al desplegar
		@paginas not path /assets/*
		header @paginas Cache-Control "no-cache"
		# una ruta de la aplicacion (/app/agenda...) no es un fichero: se devuelve index.html
		try_files {path} /index.html
		file_server
	}

	# cabeceras de seguridad para todas las respuestas
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# solo se carga codigo del propio dominio (los estilos en linea los usan las notificaciones)
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output stdout
		format console
	}
}
