# variables de entorno de Optima
# copia este fichero como .env y rellenalo. El .env NUNCA se sube a Git (esta en .gitignore)
#
# en LOCAL no hace falta: docker compose up (o ./mvnw spring-boot:run con SPRING_PROFILES_ACTIVE=dev)
# usa el perfil dev, que ya trae base de datos, clave de desarrollo y datos de demo

# --- dominio (produccion) ---
# Caddy pide el certificado HTTPS para este dominio; el DNS debe apuntar al servidor
DOMAIN=optima.tudominio.com
# direccion del frontend: enlaces de los correos y origen permitido (CORS)
FRONTEND_URL=https://optima.tudominio.com

# --- clave para firmar las sesiones (obligatoria) ---
# CAMBIAME no sirve: la app no arranca con este valor
# genera una con: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CAMBIAME
# duracion de la sesion en milisegundos (12 horas, una jornada)
JWT_EXPIRATION=43200000

# --- base de datos ---
# MySQL crea el usuario la primera vez que arranca con un volumen vacio
DB_NAME=optima_db
DB_USERNAME=optima_app
# contraseñas largas y distintas: openssl rand -base64 24
DB_PASSWORD=CAMBIAME
MYSQL_ROOT_PASSWORD=CAMBIAME

# --- correo saliente (recuperar contraseña, confirmar email, avisos a clientes) ---
# cualquier proveedor SMTP. Ejemplo con Brevo: smtp-relay.brevo.com, puerto 587
# con Gmail: smtp.gmail.com y una "contraseña de aplicación" (no la normal de la cuenta)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@tudominio.com

# --- opcionales ---
# documentacion Swagger (apagada en produccion)
SWAGGER_ENABLED=false
# imagenes publicadas por GitHub Actions (si no se indican, se construyen en el servidor)
# API_IMAGE=ghcr.io/diegonerf29/optima-api:latest
# WEB_IMAGE=ghcr.io/diegonerf29/optima-web:latest
