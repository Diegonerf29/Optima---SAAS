# clave JWT para firmar tokens de sesion (obligatoria en produccion)
# CAMBIAME no sirve: la app no arranca con este valor
# genera una clave aleatoria con: openssl rand -base64 64
# la salida ocupa 2 lineas: pegala aqui en una sola linea, sin espacios
# en local no hace falta generarla: arranca con el perfil dev
#   con Docker: pon SPRING_PROFILES_ACTIVE=dev en tu .env
#   sin Docker: SPRING_PROFILES_ACTIVE=dev ./mvnw spring-boot:run
JWT_SECRET=CAMBIAME

# duracion de sesion en milisegundos (12 horas, una jornada)
JWT_EXPIRATION=43200000

# correo saliente (opcional, solo para "olvide mi contrasena")
# si lo dejas comentado la app arranca igual pero no envia emails
# MAIL_PASSWORD es una app-password de Gmail, no la contrasena normal de la cuenta
# MAIL_USERNAME=tu-cuenta@gmail.com
# MAIL_PASSWORD=tu-app-password-de-gmail

# direccion del frontend
FRONTEND_URL=http://localhost:5173

# documentacion Swagger activa
SWAGGER_ENABLED=true
