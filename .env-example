# clave JWT para firmar tokens de sesion
# valor de desarrollo: funciona en local sin tocar nada
# en produccion define una clave aleatoria de 64+ caracteres (no reutilices esta)
JWT_SECRET=dev-secret-solo-para-local-no-usar-en-produccion-0123456789

# duracion de sesion en milisegundos (4 horas)
JWT_EXPIRATION=14400000

# correo saliente (opcional, solo para "olvide mi contrasena")
# si lo dejas comentado la app arranca igual pero no envia emails
# MAIL_PASSWORD es una app-password de Gmail, no la contrasena normal de la cuenta
# MAIL_USERNAME=tu-cuenta@gmail.com
# MAIL_PASSWORD=tu-app-password-de-gmail

# direccion del frontend
FRONTEND_URL=http://localhost:5173

# documentacion Swagger activa
SWAGGER_ENABLED=true
